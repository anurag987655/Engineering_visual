# Copy to .env.local for local development. In Vercel, set these in
# Project Settings → Environment Variables (Production and Preview).

# Public origin of the deployed site, without a trailing slash.
# Used for metadataBase, sitemap.xml, and robots.txt URLs.
# Local default (unset): http://localhost:3000
# Vercel example: https://your-domain.example
NEXT_PUBLIC_SITE_URL=

# Where the /api/feedback route stores submissions.
#   file    (default) appends to ./data/feedback.jsonl — local/self-hosted only;
#           on read-only serverless hosts (e.g. Vercel) saves fail and the API
#           responds 503 until a remote sink is configured.
#   console logs each entry to the server console instead of a file.
FEEDBACK_SINK=file
